# @public
OTEL_SERVICE_NAME=

# @public
OTEL_EXPORTER_OTLP_ENDPOINT=

# @public
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# @sensitive
OTEL_EXPORTER_OTLP_HEADERS=

# @public
OTEL_TRACES_EXPORTER=

# @public
OTEL_GENAI_CAPTURE_CONTENT=

