# @defaultRequired=false
# ---

# Linear personal API key used by weavekit-mastermind.
# Loaded from the root LINEAR_API_KEY entry in ~/.weavekit/config.toml before Varlock validates it.
# @required @sensitive
LINEAR_API_KEY=

# Linear webhook signing secret for a persistent Mastermind webhook.
# Loaded from the root LINEAR_WEBHOOK_SECRET entry in ~/.weavekit/config.toml.
# @sensitive
LINEAR_WEBHOOK_SECRET=

# Langfuse public key used by the OpenTelemetry exporter.
# Loaded from the root LANGFUSE_PUBLIC_KEY entry in ~/.weavekit/config.toml.
# @sensitive
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key used by the OpenTelemetry exporter.
# Loaded from the root LANGFUSE_SECRET_KEY entry in ~/.weavekit/config.toml.
# @sensitive
LANGFUSE_SECRET_KEY=

# Langfuse UI/API base URL, for example http://localhost:3000.
# @public
LANGFUSE_BASE_URL=

# Langfuse project ID used to print direct trace URLs.
# @public
LANGFUSE_PROJECT_ID=

# Explicit opt-in for exporting raw prompts and responses. Defaults to false.
# @public
LANGFUSE_EXPORT_RAW=

# Optional Mastermind synthesis-only model override. Defaults to gemini-3.6-flash when unset.
# @public
MASTERMIND_SYNTHESIS_MODEL=
